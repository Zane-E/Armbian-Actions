From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SuperKali <hello@superkali.me>
Date: Thu, 3 Sep 2026 11:24:59 +0200
Subject: rpmsg: qcom_glink: Fix deadlock during endpoint teardown

The rpmsg core invokes destroy_ept() for a default endpoint while holding
the rpmsg device lock. The GLINK implementation then unregisters the same
rpmsg device synchronously, which tries to acquire that lock again and
deadlocks when a client such as FastRPC is unbound.

Record the rpmsg device that owns each default endpoint and defer
unregistering it until CLOSE or CLOSE_ACK is received. Keep immediate
removal for manually created endpoints. Use xchg() to prevent concurrent
close paths from unregistering an rpmsg device more than once.

Signed-off-by: Junhao Xie <bigfoot@radxa.com>

(cherry picked from commit 52416bb251e572d1dc713cce186c9e80eba8a3a8)
[SuperKali: forward-ported from radxa/kernel linux-7.0.11 to Linux 7.2.3]
Signed-off-by: SuperKali <hello@superkali.me>
---
 drivers/rpmsg/qcom_glink_native.c | 26 ++++++----
 1 file changed, 17 insertions(+), 9 deletions(-)

diff --git a/drivers/rpmsg/qcom_glink_native.c b/drivers/rpmsg/qcom_glink_native.c
index 111111111111..222222222222 100644
--- a/drivers/rpmsg/qcom_glink_native.c
+++ b/drivers/rpmsg/qcom_glink_native.c
@@ -1399,13 +1399,13 @@ static void qcom_glink_remove_rpmsg_devi
 {
 	struct rpmsg_channel_info chinfo;
 
-	if (channel->rpdev) {
-		strscpy_pad(chinfo.name, channel->name, sizeof(chinfo.name));
-		chinfo.src = RPMSG_ADDR_ANY;
-		chinfo.dst = RPMSG_ADDR_ANY;
-		rpmsg_unregister_device(glink->dev, &chinfo);
-	}
-	channel->rpdev = NULL;
+	if (!xchg(&channel->rpdev, NULL))
+		return;
+
+	strscpy_pad(chinfo.name, channel->name, sizeof(chinfo.name));
+	chinfo.src = RPMSG_ADDR_ANY;
+	chinfo.dst = RPMSG_ADDR_ANY;
+	rpmsg_unregister_device(glink->dev, &chinfo);
 }
 
 static void qcom_glink_destroy_ept(struct rpmsg_endpoint *ept)
@@ -1418,6 +1418,15 @@ static void qcom_glink_destroy_ept(struc
 	channel->ept.cb = NULL;
 	spin_unlock_irqrestore(&channel->recv_lock, flags);
 
+	/*
+	 * rpmsg core destroys the default endpoint with the rpdev's device lock
+	 * held. Defer unregistering that rpdev until CLOSE/CLOSE_ACK is received.
+	 * A manually created endpoint may own a different rpdev, which must be
+	 * removed now.
+	 */
+	if (channel->rpdev != ept->rpdev)
+		qcom_glink_remove_rpmsg_device(glink, channel);
+
 	qcom_glink_send_close_req(glink, channel);
 }
 
@@ -1675,6 +1684,7 @@ static int qcom_glink_rx_open(struct qco
 		}
 
 		rpdev->ept = &channel->ept;
+		channel->ept.rpdev = rpdev;
 		strscpy(rpdev->id.name, name);
 		rpdev->src = RPMSG_ADDR_ANY;
 		rpdev->dst = RPMSG_ADDR_ANY;
@@ -1878,6 +1888,7 @@ static int qcom_glink_create_chrdev(stru
 	channel->rpdev = rpdev;
 
 	rpdev->ept = &channel->ept;
+	channel->ept.rpdev = rpdev;
 	rpdev->ops = &glink_device_ops;
 	rpdev->dev.parent = glink->dev;
 	rpdev->dev.release = qcom_glink_device_release;
-- 
