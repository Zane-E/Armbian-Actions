#!/bin/bash

# ==============================================================================
#  脚本名称：install-pve
#  适用架构：ARM64 (aarch64/arm64)
#  脚本功能：Armbian (ARM64) 系统安装 Pxvirt or Proxmox VE
#  适用系统：Debian 12 (bookworm) -> Pxvirt 8 | Debian 13 (trixie) -> PVE 9
#  功能说明：配置国内源、添加 Proxmox VE 源、内存占用优化、配置网桥与 IPv6 参数
# ==============================================================================

set -o pipefail

readonly STEPS="[\033[95m 步骤 \033[0m]"
readonly INFO="[\033[94m 信息 \033[0m]"
readonly SUCCESS="[\033[92m 成功 \033[0m]"
readonly OPTIONS="[\033[93m 选项 \033[0m]"
readonly ERROR="[\033[91m 错误 \033[0m]"
readonly SN="[\033[96m 序号 \033[0m]"
readonly SOURCE_MARK="# Generated by install-pve"

ADDR_INFO=""
ARCH=""
CIDR=""
GATEWAY=""
IP_ADDR=""
MAC_ADDR=""
mirror=""
NET_IF=""
NET_IF_LIST=""
NETMASK=""
NETMASK_DECIMAL=""
pve_repo_type=""
SCRIPT_DIR=""
VERSION_CODENAME=""

log_error() {
    echo -e "${ERROR} ${1}"
}

die() {
    log_error "${1}"
    exit 1
}

error() {
    die "${1}"
}

require_command() {
    command -v "${1}" >/dev/null 2>&1 || error "缺少依赖命令：[\033[92m ${1} \033[0m]"
}

check_dependencies() {
    local cmd
    local required_commands=(apt-get awk cat chmod cp curl cut dirname grep head hostnamectl id ip python3 reboot rm sed sleep sort systemctl tr uname wc)

    for cmd in "${required_commands[@]}"; do
        require_command "${cmd}"
    done
}

prompt_yes_no() {
    local prompt="${1}"
    local default="${2:-y}"
    local choice

    read -r -p "$(echo -e "${prompt}")" choice
    choice="${choice:-${default}}"
    [[ "${choice}" =~ ^[Yy]$ ]]
}

download_file() {
    local output_file="${1}"
    local url="${2}"

    curl -fsSL --retry 3 --retry-delay 1 --connect-timeout 5 --max-time 60 \
        -o "${output_file}" "${url}" >/dev/null 2>&1
}

fetch_text() {
    local url="${1}"
    local max_time="${2:-5}"

    curl -fsSL --retry 2 --retry-delay 1 --connect-timeout 3 --max-time "${max_time}" "${url}"
}

url_available() {
    local url="${1}"
    local max_time="${2:-3}"

    curl -fIsL --retry 2 --retry-delay 1 --connect-timeout 3 --max-time "${max_time}" "${url}" >/dev/null 2>&1
}

check_env() {
    [[ "$(id -u)" -eq 0 ]] || error "请使用 root 用户运行！"
    [[ -d /run/systemd/system ]] || error "当前系统非 systemd 管理，无法继续！"
    [[ -f /etc/os-release ]] || error "未找到 /etc/os-release 文件！"

    if pgrep -x "apt" >/dev/null || pgrep -x "apt-get" >/dev/null || pgrep -x "dpkg" >/dev/null; then
        error "检测到后台正在运行 apt/dpkg 进程，请等待其完成后再试！"
    fi

    local free_space
    free_space=$(df / --output=avail | tail -n1 | tr -d ' ')
    if [[ "${free_space}" -lt 3145728 ]]; then
        error "根目录空间不足 3GB，无法完成 Proxmox VE 安装！"
    fi

    source /etc/os-release

    [[ "${VERSION_CODENAME}" =~ ^(bookworm|trixie)$ ]] ||
        error "当前系统 [\033[91m ${VERSION_CODENAME} \033[0m] 不支持！"

    ARCH=$(uname -m)
    [[ "${ARCH}" =~ ^(aarch64|arm64)$ ]] ||
        error "当前架构 [\033[91m ${ARCH} \033[0m] 非 ARM64 架构！"

    if [[ ! -e /dev/kvm ]]; then
        echo -e "${INFO} \033[94m未检测到 /dev/kvm，当前内核可能未开启 KVM，将无法运行 QEMU 虚拟机（LXC 容器不受影响）！\033[0m"
    fi
}

is_bridge_or_member() {
    ip -d link show "${1}" | grep -Eq "bridge|brport"
}

is_wireless() {
    [[ -d "/sys/class/net/${1}/wireless" ]] ||
        [[ -e /proc/net/wireless && $(awk -v iface="${1}:" '$1 == iface {print $1}' /proc/net/wireless) ]]
}

check_select_interface() {
    local color
    local comment
    local iface
    local i
    local idx
    local ip_addr
    local mark
    local selectable
    local sn_choice
    local valid_if_list=()
    local valid_index=()

    NET_IF_LIST=$(ip route | awk '/^default/ {for (i = 1; i <= NF; i++) if ($i == "dev") print $(i + 1)}' | sort -u)
    [[ -n "${NET_IF_LIST}" ]] || error "未找到默认网络接口，请检查网络配置！"

    if [[ $(echo "${NET_IF_LIST}" | wc -l) -gt 1 ]]; then
        echo -e "${OPTIONS} 检测到多个默认网络接口，请选择："
        i=1
        for iface in ${NET_IF_LIST}; do
            ip_addr=$(ip -4 addr show "${iface}" | awk '/inet /{print $2}' | cut -d/ -f1 | head -n 1)
            if is_bridge_or_member "${iface}"; then
                mark="[\033[91m x \033[0m]"
                color="\033[91m"
                comment="[\033[91m 桥接接口 \033[0m]"
                selectable="no"
            elif is_wireless "${iface}"; then
                mark="[\033[91m x \033[0m]"
                color="\033[91m"
                comment="[\033[91m 无线接口 \033[0m]"
                selectable="no"
            else
                mark="[\033[92m ✓ \033[0m]"
                color="\033[92m"
                comment="[\033[92m 有线接口 \033[0m]"
                selectable="yes"
            fi

            echo -e "${SN} [\033[96m ${i} \033[0m] -> [${color} ${iface} - ${ip_addr:-无 IP} \033[0m] ${comment} ${mark}"

            if [[ "${selectable}" == "yes" ]]; then
                valid_if_list+=("${iface}")
                valid_index+=("${i}")
            fi
            i=$((i + 1))
        done

        [[ ${#valid_if_list[@]} -gt 0 ]] || error "所有默认网络接口均不可用，请调整后重试！"

        while true; do
            read -r -p "$(echo -e "${OPTIONS} 请输入序号：")" sn_choice
            sn_choice="${sn_choice:-1}"

            for idx in "${!valid_index[@]}"; do
                if [[ "${sn_choice}" == "${valid_index[$idx]}" ]]; then
                    NET_IF="${valid_if_list[$idx]}"
                    break 2
                fi
            done

            echo -e "${ERROR} 输入无效或该接口不可使用，请重新输入！"
        done
    else
        NET_IF="${NET_IF_LIST}"
        ip_addr=$(ip -4 addr show "${NET_IF}" | awk '/inet /{print $2}' | cut -d/ -f1 | head -n 1)

        is_bridge_or_member "${NET_IF}" &&
            error "默认网络接口 [\033[91m ${NET_IF} - ${ip_addr:-无 IP} \033[0m] 属于桥接接口，请调整后重试！"
        is_wireless "${NET_IF}" &&
            error "默认网络接口 [\033[91m ${NET_IF} - ${ip_addr:-无 IP} \033[0m] 属于无线接口，请使用有线接口！"

        echo -e "${INFO} 检测到默认网络接口：[\033[92m ${NET_IF} - ${ip_addr:-无 IP} \033[0m]"
    fi
}

cidr_to_netmask() {
    local cidr="${1}"
    local full_octets
    local i
    local mask=""
    local remainder

    if [[ -z "${cidr}" || "${cidr}" -le 0 || "${cidr}" -gt 32 ]]; then
        error "子网掩码位数无效！"
    fi

    full_octets=$((cidr / 8))
    remainder=$((cidr % 8))

    for ((i = 0; i < 4; i++)); do
        if (( i < full_octets )); then
            mask+=255
        elif (( i == full_octets )); then
            mask+=$((256 - 2**(8 - remainder)))
        else
            mask+=0
        fi
        [[ ${i} -lt 3 ]] && mask+=.
    done

    echo "${mask}"
}

detect_network_info() {
    [[ -n "${NET_IF}" ]] || error "未检测到有效的网络接口！"

    ADDR_INFO=$(ip -4 addr show "${NET_IF}" | awk '/inet / {print $2; exit}')
    IP_ADDR=${ADDR_INFO%/*}
    CIDR=${ADDR_INFO#*/}
    GATEWAY=$(ip route | awk -v iface="${NET_IF}" '$1 == "default" && $0 ~ ("dev " iface) {print $3; exit}')
    MAC_ADDR=$(cat "/sys/class/net/${NET_IF}/address" 2>/dev/null)
    [[ -n "${CIDR}" ]] && NETMASK=$(cidr_to_netmask "${CIDR}")

    if [[ -z "${IP_ADDR}" || -z "${GATEWAY}" || -z "${CIDR}" || -z "${NETMASK}" ]]; then
        error "获取网络信息失败，请检查接口 ${NET_IF} 是否配置 IPv4！"
    fi

    echo -e "${INFO} 接口：\033[95m${NET_IF}\033[0m"
    echo -e "${INFO} IPv4：\033[95m${IP_ADDR}\033[0m"
    echo -e "${INFO} 网关：\033[95m${GATEWAY}\033[0m"
    echo -e "${INFO} 掩码：\033[95m${NETMASK}\033[0m"
    echo -e "${INFO} MAC ：\033[95m${MAC_ADDR}\033[0m"
}

confirm_source() {
    echo -e "${INFO} 请确认系统已更换为国内镜像软件源！"
    echo -e "${INFO} 网络环境可以稳定访问官方源，输入 Y 忽略！"

    if prompt_yes_no "${OPTIONS} 是否已更换为国内源？[y/\033[92mN\033[0m]：" "n"; then
        return 0
    fi

    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -x "${SCRIPT_DIR}/armbian-apt" ]]; then
        echo -e "${STEPS} 正在调用本地 [\033[92m armbian-apt \033[0m] 选择国内源！"
        "${SCRIPT_DIR}/armbian-apt"
    elif command -v armbian-apt >/dev/null 2>&1; then
        echo -e "${STEPS} 正在调用系统 [\033[92m armbian-apt \033[0m] 选择国内源！"
        armbian-apt
    else
        error "未找到 [\033[92m armbian-apt \033[0m]，请手动更换国内源！"
    fi

    prompt_yes_no "${OPTIONS} 是否进行安装？[\033[92mY\033[0m/n]：" "y" ||
        { echo -e "${INFO} 中止安装，已退出！"; exit 0; }
}

backup_and_comment_sources() {
    local bak
    local file

    echo -e "${INFO} 开始配置环境..."

    for file in /etc/apt/sources.list.d/armbian.sources /etc/apt/sources.list.d/armbian-config.sources; do
        bak="${file}.bak"
        if [[ -f "${file}" && ! -f "${bak}" ]]; then
            cp "${file}" "${bak}" || error "备份失败：${file}"
            echo -e "${STEPS} 已备份：\033[95m${bak}\033[0m"
        fi
        if [[ -f "${file}" ]]; then
            sed -i 's/^\([^#]\)/#\1/' "${file}" || error "注释失败：${file}"
            echo -e "${STEPS} 已注释：\033[95m${file}\033[0m"
        fi
    done

}

setup_repositories_lierfang() {
    local country
    local keyring="/usr/share/keyrings/lierfang-archive-keyring.gpg"
    local mirror=""
    local primary
    local region
    local source_file="/etc/apt/sources.list.d/pxvirt.sources"
    local src

    pve_repo_type="lierfang"

    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

    country=$(fetch_text https://ipinfo.io/country 3 2>/dev/null || echo "UNKNOWN")
    country=$(echo "${country}" | tr -d '[:space:]')
    country=${country:-UNKNOWN}

    declare -A mirrors
    mirrors[CN]="https://cn.mirrors.lierfang.com"
    mirrors[JP]="https://jp.mirrors.lierfang.com"
    mirrors[US]="https://us.mirrors.lierfang.com"
    mirrors[DEFAULT]="https://mirrors.lierfang.com"

    case "${country}" in
        CN) primary="${mirrors[CN]}"; region="China" ;;
        JP) primary="${mirrors[JP]}"; region="Japan" ;;
        US) primary="${mirrors[US]}"; region="America" ;;
        UNKNOWN|*) primary="${mirrors[DEFAULT]}"; region="Cloudflare" ;;
    esac

    echo -e "${INFO} 检测到地区：\033[95m${country}\033[0m → 首选源：\033[95m${region} (${primary})\033[0m"

    if url_available "${primary}/pxcloud/" 5; then
        mirror="${primary}"
        echo -e "${INFO} 首选源可用 → 使用：\033[95m${region} (${mirror})\033[0m"
    else
        echo -e "${INFO} 首选源不可用：\033[95m${primary}\033[0m"
        if [[ "${primary}" != "${mirrors[DEFAULT]}" ]]; then
            echo -e "${INFO} 尝试 \033[95mCloudflare\033[0m 源..."
            if url_available "${mirrors[DEFAULT]}/pxcloud/" 3; then
                mirror="${mirrors[DEFAULT]}"
                region="Cloudflare"
                echo -e "${INFO} \033[95mCloudflare\033[0m 源可用 → 使用：\033[95m${region} (${mirror})\033[0m"
            else
                echo -e "${INFO} \033[95mCloudflare\033[0m 源不可用：\033[95m${mirrors[DEFAULT]}\033[0m"
            fi
        fi

        if [[ -z "${mirror}" ]]; then
            echo -e "${INFO} 尝试备用源..."
            for src in "${mirrors[CN]}" "${mirrors[JP]}" "${mirrors[US]}"; do
                [[ "${src}" == "${primary}" ]] && continue
                if url_available "${src}/pxcloud/" 3; then
                    mirror="${src}"
                    case "${src}" in
                        "${mirrors[CN]}") region="China" ;;
                        "${mirrors[JP]}") region="Japan" ;;
                        "${mirrors[US]}") region="America" ;;
                    esac
                    echo -e "${INFO} 找到可用备用源 → 使用：\033[95m${region} (${mirror})\033[0m"
                    break
                fi
                echo -e "${INFO} 备用源不可用：\033[95m${src}\033[0m"
            done
        fi
    fi

    [[ -n "${mirror}" ]] || error "所有软件源均不可用，请检查网络！"

    if download_file "${keyring}" "${mirror}/pxcloud/lierfang.gpg"; then
        echo -e "${STEPS} 已下载：\033[95m${keyring}\033[0m"
    else
        error "下载 lierfang.gpg 失败！"
    fi

    cat > "${source_file}" <<EOF
${SOURCE_MARK}
Types: deb
URIs: ${mirror}/pxcloud/pxvirt
Suites: ${VERSION_CODENAME}
Components: main
Signed-By: ${keyring}
EOF
    [[ $? -eq 0 ]] || error "写入 pxvirt.sources 失败！"
    echo -e "${STEPS} 已写入：\033[95m${source_file}\033[0m"
}

setup_repositories_proxmox() {
    local keyring="/usr/share/keyrings/proxmox-archive-keyring.gpg"
    local keyring_url="https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg"
    local source_file="/etc/apt/sources.list.d/pve-no-subscription.sources"

    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

    echo -e "${INFO} 请选择 [\033[92m Proxmox VE \033[0m] 软件源！"
    echo -e "${SN} [\033[96m 1 \033[0m] -> [\033[92m 高校联合•自动选择 \033[0m]"
    echo -e "${SN} [\033[96m 2 \033[0m] -> [\033[92m 中国科学技术大学 \033[0m]"
    echo -e "${SN} [\033[96m 3 \033[0m] -> [\033[92m 北京外国语大学 \033[0m]"
    echo -e "${SN} [\033[96m 4 \033[0m] -> [\033[92m 清华大学 \033[0m]"
    echo -e "${SN} [\033[96m 5 \033[0m] -> [\033[92m 南京大学 \033[0m]"
    echo -e "${SN} [\033[96m 6 \033[0m] -> [\033[92m 官方源 \033[0m]"

    while true; do
        read -r -p "$(echo -ne "${OPTIONS} 请输入序号 [\033[96m 1-6 \033[0m] [ 回车默认 \033[96m1\033[0m ]：")" choice
        choice=${choice:-1}

        case "$choice" in
            1) mirror="https://mirrors.cernet.edu.cn/proxmox/debian/pve" ;;
            2) mirror="https://mirrors.ustc.edu.cn/proxmox/debian/pve" ;;
            3) mirror="https://mirrors.bfsu.edu.cn/proxmox/debian/pve" ;;
            4) mirror="https://mirrors.tuna.tsinghua.edu.cn/proxmox/debian/pve" ;;
            5) mirror="https://mirrors.nju.edu.cn/proxmox/debian/pve" ;;
            6) mirror="http://download.proxmox.com/debian/pve" ;;
            *) echo -e "${ERROR} 输入无效，请重新选择！"; continue ;;
        esac

        break
    done

    echo -e "${INFO} 使用软件源：\033[94m${mirror}\033[0m"

    if download_file "${keyring}" "${keyring_url}"; then
        echo -e "${STEPS} 已下载：\033[95m${keyring}\033[0m"
    else
        error "下载 proxmox-archive-keyring.gpg 失败！"
    fi

    cat > "${source_file}" <<EOF
${SOURCE_MARK}
Types: deb
URIs: ${mirror}
Suites: ${VERSION_CODENAME}
Components: pve-no-subscription
Signed-By: ${keyring}
EOF

    [[ $? -eq 0 ]] || error "写入 pve-no-subscription.sources 失败！"

    echo -e "${STEPS} 已写入：\033[95m${source_file}\033[0m"
}

repositories_select() {
    while true; do
        echo -e "${INFO} 请选择版本："
        echo -e "${SN} [\033[96m 1 \033[0m] -> Proxmox VE 9 [\033[92m 官方版 by Proxmox \033[0m]"
        echo -e "${SN} [\033[96m 2 \033[0m] -> Proxmox VE 9 [\033[92m 定制版 by Lierfang \033[0m]"
        read -r -p "$(echo -e "${OPTIONS} 请输入 [\033[96m 1-2 \033[0m] [ 回车默认 \033[92m1\033[0m ]：" )" select_choice

        select_choice="${select_choice:-1}"

        case "${select_choice}" in
            1) pve_repo_type="proxmox"; setup_repositories_proxmox; break ;;
            2) pve_repo_type="lierfang"; setup_repositories_lierfang; break ;;
            *) echo -e "${ERROR} 输入错误，请重新选择！" ;;
        esac
    done
}

setup_networking() {
    echo -e "${STEPS} 正在配置网络服务及清理多余依赖..."
    apt-get update >/dev/null 2>&1 || error "更新软件源失败！"
    apt-get install -y ifupdown2 >/dev/null 2>&1 || error "安装网络组件失败！"
    systemctl enable networking >/dev/null 2>&1 || error "启用 networking 服务失败！"
    systemctl disable systemd-networkd systemd-networkd.socket systemd-resolved resolvconf NetworkManager >/dev/null 2>&1 || true
    apt-get remove -y netplan.io >/dev/null 2>&1 || true
    apt-get autoremove -y >/dev/null 2>&1 || true
}

set_hostname() {
    local current_hostname
    local new_hostname_choice

    current_hostname=$(tr -d ' \t\n\r' < /etc/hostname)
    read -r -p "$(echo -e "${OPTIONS} 自定义主机名 [ 回车忽略 ]：")" new_hostname_choice

    if [[ -n "${new_hostname_choice}" ]]; then
        hostnamectl set-hostname "${new_hostname_choice}" || error "设置主机名失败！"
        echo -e "${SUCCESS} 主机名已更改为：[\e[1;32m ${new_hostname_choice} \e[0m]"
    else
        echo -e "${INFO} 保持当前主机名：[\e[1;32m ${current_hostname} \e[0m]"
    fi
}

configure_network() {
    local current_hostname

    NETMASK_DECIMAL=$(cidr_to_netmask "${CIDR}")

    echo -e "${STEPS} 配置 \033[95m/etc/network/interfaces\033[0m"
    cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback

auto ${NET_IF}
iface ${NET_IF} inet static
    hwaddress ether ${MAC_ADDR}
    address ${IP_ADDR}
    netmask ${NETMASK_DECIMAL}
    gateway ${GATEWAY}
EOF
    [[ $? -eq 0 ]] || error "写入 /etc/network/interfaces 失败！"

    echo -e "${STEPS} 配置 \033[95m/etc/resolv.conf\033[0m"
    rm -f /etc/resolv.conf
    cat > /etc/resolv.conf <<EOF
search lan
nameserver ${GATEWAY}
EOF
    [[ $? -eq 0 ]] || error "写入 /etc/resolv.conf 失败！"

    current_hostname=$(tr -d ' \t\n\r' < /etc/hostname)
    echo -e "${STEPS} 配置 \033[95m/etc/hosts\033[0m"
    cat > /etc/hosts <<EOF
127.0.0.1       localhost
${IP_ADDR}   ${current_hostname}.local ${current_hostname}
::1             localhost ip6-localhost ip6-loopback
fe00::0         ip6-localnet
ff00::0         ip6-mcastprefix
ff02::1         ip6-allnodes
ff02::2         ip6-allrouters
EOF
    [[ $? -eq 0 ]] || error "写入 /etc/hosts 失败！"
}

pve_major_version() {
    if [[ "${VERSION_CODENAME}" == "bookworm" ]]; then
        echo 8
    else
        echo 9
    fi
}

install_pve() {
    local pve_version

    pve_version=$(pve_major_version)
    echo -e "${INFO} 安装 \033[94mProxmox VE ${pve_version}...\033[0m"

    if apt-get update; then

        local install_result=0

        if [[ "${pve_repo_type}" == "proxmox" ]]; then
            apt-get install -y pve-manager qemu-server pve-qemu-kvm || install_result=$?
        else
            apt-get install -y proxmox-ve || install_result=$?
        fi

        if [[ ${install_result} -eq 0 ]]; then

            if [[ -f /etc/ophub-release ]]; then
                echo -e "${STEPS} 正在更新证书..."
                require_command pvecm
                rm -f /etc/pve/pve-root-ca.pem /etc/pve/priv/pve-root-ca.* /etc/pve/local/pve-ssl.*
                pvecm updatecerts -f >/dev/null 2>&1 || true
                systemctl restart pveproxy >/dev/null 2>&1 || error "无法重启 pveproxy 服务，请检查！"
                echo -e "${SUCCESS} 证书更新成功！"
            fi

            if [[ -f /etc/apt/sources.list.d/pxvirt-sources.list ]]; then
                rm -f /etc/apt/sources.list.d/pxvirt-sources.list
            fi

            echo -e "${SUCCESS} Proxmox VE ${pve_version} 安装成功！请重启设备后浏览器访问：[\033[92m https://${IP_ADDR}:8006 \033[0m]"

        else
            error "Proxmox VE ${pve_version} 安装失败，请检查源和网络！"
        fi

    else
        error "apt update 失败，请检查源和网络！"
    fi
}

optimize_memory() {
    local file
    local files
    local services
    local svc

    if ! prompt_yes_no "${OPTIONS} 是否进行内存优化？[\033[92mY\033[0m/n]：" "y"; then
        echo -e "${INFO} 已跳过内存优化！"
        return 0
    fi

    echo -e "${INFO} 开始内存优化..."
    services=(
        postfix.service
        pve-ha-lrm.service
        pve-ha-crm.service
        spiceproxy.service
        pve-firewall.service
        pvefw-logger.service
        pvescheduler.service
    )

    for svc in "${services[@]}"; do
        systemctl stop "${svc}" >/dev/null 2>&1 || true
        systemctl disable "${svc}" >/dev/null 2>&1 || true
        echo -e "${STEPS} 已停止并禁用：\033[95m${svc}\033[0m"
    done

    echo -e "${STEPS} 添加延启脚本：\033[95m/usr/sbin/pve-optimize.sh\033[0m"
    cat > /usr/sbin/pve-optimize.sh <<'EOF'
#!/bin/bash

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

LOG="/var/log/pve-optimize.log"

sleep 300

SERVICES=(
  pve-ha-lrm.service
  pve-ha-crm.service
  spiceproxy.service
  pve-firewall.service
  pvefw-logger.service
  pvescheduler.service
)

echo "$(date): Starting PVE optimize" > "${LOG}"

for svc in "${SERVICES[@]}"; do
  if systemctl stop "${svc}" >/dev/null 2>&1; then
    echo "$(date): stopped ${svc}" >> "${LOG}"
  else
    echo "$(date): failed ${svc}" >> "${LOG}"
  fi
done

echo "$(date): All down!!!" >> "${LOG}"

exit 0
EOF
    [[ $? -eq 0 ]] || log_error "写入 /usr/sbin/pve-optimize.sh 失败！"
    chmod +x /usr/sbin/pve-optimize.sh || log_error "设置 /usr/sbin/pve-optimize.sh 权限失败！"

    echo -e "${STEPS} 写入开机延启任务至：\033[95m/etc/cron.d/pve-optimize\033[0m"
    cat > /etc/cron.d/pve-optimize <<EOF
# 开机时以 root 用户执行 PVE 内存优化脚本
@reboot root /usr/sbin/pve-optimize.sh
EOF
    [[ $? -eq 0 ]] || log_error "写入 /etc/cron.d/pve-optimize 失败！"
    systemctl restart cron >/dev/null 2>&1 || true

    files=(
        /usr/share/perl5/PVE/Service/pveproxy.pm
        /usr/share/perl5/PVE/Service/pvedaemon.pm
        /usr/share/perl5/PVE/Service/spiceproxy.pm
    )

    for file in "${files[@]}"; do
        if [[ -f "${file}" ]] && grep -q 'max_workers[[:space:]]*=>[[:space:]]*3' "${file}"; then
            if [[ ! -f "${file}.bak" ]]; then
                cp -p "${file}" "${file}.bak" || log_error "备份失败：${file}.bak"
                echo -e "${STEPS} 已备份：\033[95m${file}.bak\033[0m"
            fi

            sed -i 's|max_workers[[:space:]]*=>[[:space:]]*3|max_workers => 1|' "${file}" ||
                log_error "修改失败：${file}"
            echo -e "${STEPS} 已修改：\033[95m${file}\033[0m"
        else
            echo -e "${STEPS} 已跳过：\033[95m${file}\033[0m"
        fi
    done

    echo -e "${SUCCESS} 内存优化完成！"
}

create_vmbr0() {
    if ! prompt_yes_no "${OPTIONS} 是否创建网桥？[\033[92mY\033[0m/n]：" "y"; then
        echo -e "${INFO} 已跳过网桥创建！"
        return 0
    fi

    echo -e "${STEPS} 配置 \033[95m/etc/network/interfaces\033[0m"
    cat > /etc/network/interfaces <<EOF
auto lo
iface lo inet loopback

iface ${NET_IF} inet manual
    hwaddress ether ${MAC_ADDR}

auto vmbr0
iface vmbr0 inet static
    address ${IP_ADDR}
    gateway ${GATEWAY}
    netmask ${NETMASK_DECIMAL}
    bridge-ports ${NET_IF}
    bridge-stp off
    bridge-fd 0
EOF
    [[ $? -eq 0 ]] || error "写入 /etc/network/interfaces 失败！"

    if [[ "${VERSION_CODENAME}" == "trixie" ]]; then
        grep -qxF "source /etc/network/interfaces.d/sdn" /etc/network/interfaces ||
            sed -i '1i source /etc/network/interfaces.d/sdn' /etc/network/interfaces ||
                log_error "添加 SDN 配置引用失败！"

        [[ -d /etc/network/interfaces.d ]] || mkdir -p /etc/network/interfaces.d || log_error "创建网络配置目录失败！"
        [[ -f /etc/network/interfaces.d/sdn ]] || touch /etc/network/interfaces.d/sdn || log_error "创建 sdn 配置文件失败！"
    fi

    echo -e "${SUCCESS} 网桥 vmbr0 配置已写入！"
}

configure_ipv6_sysctl() {
    if ! prompt_yes_no "${OPTIONS} 是否配置 IPV6 参数？[\033[92mY\033[0m/n]：" "y"; then
        echo -e "${INFO} 已跳过参数设置！"
        return 0
    fi

    echo -e "${INFO} 开始配置 IPv6 参数..."

    local sysctl_file="/etc/sysctl.d/99-ipv6.conf"

    cat > "${sysctl_file}" <<EOF
net.ipv6.conf.all.accept_ra = 2
net.ipv6.conf.default.accept_ra = 2
net.ipv6.conf.all.autoconf = 1
net.ipv6.conf.default.autoconf = 1
EOF

    if [ $? -eq 0 ]; then
        echo -e "${STEPS} 配置文件：\033[95m${sysctl_file}\033[0m"
        echo -e "${STEPS} 添加参数：\033[95mnet.ipv6.conf.all.accept_ra = 2\033[0m"
        echo -e "${STEPS} 添加参数：\033[95mnet.ipv6.conf.default.accept_ra = 2\033[0m"
        echo -e "${STEPS} 添加参数：\033[95mnet.ipv6.conf.all.autoconf = 1\033[0m"
        echo -e "${STEPS} 添加参数：\033[95mnet.ipv6.conf.default.autoconf = 1\033[0m"
        echo -e "${SUCCESS} IPv6 参数配置成功！"
    else
        log_error "IPv6 参数配置失败！"
    fi
}

patch_pve_kernel_version() {
    if ! prompt_yes_no "${OPTIONS} 是否修复内核版本显示异常？[\033[92mY\033[0m/n]：" "y"; then
        echo -e "${INFO} 已跳过修改！"
        return 0
    fi

    local file="/usr/share/pve-manager/js/pvemanagerlib.js"

    if [[ ! -f "${file}" ]]; then
        echo -e "${INFO} 未找到文件：${file}，已跳过修改！"
        return 0
    fi

    python3 - "${file}" <<'EOF'
from pathlib import Path
import sys

file = Path(sys.argv[1])

old = r'''        {
            colspan: 2,
            title: gettext('Kernel Version'),
            printBar: false,
            // TODO: remove with next major and only use newish current-kernel textfield
            multiField: true,
            //textField: 'current-kernel',
            renderer: ({ data }) => {
                if (!data['current-kernel']) {
                    return data.kversion;
                }
                let kernel = data['current-kernel'];
                let buildDate = kernel.version.match(/\((.+)\)\s*$/)?.[1] ?? 'unknown';
                return `${kernel.sysname} ${kernel.release} (${buildDate})`;
            },
            value: '',
        },'''

new = r'''        {
            colspan: 2,
            title: gettext('Kernel Version'),
            printBar: false,
            // TODO: remove with next major and only use newish current-kernel textfield
            multiField: true,
            //textField: 'current-kernel',
            renderer: ({ data }) => {
                if (!data['current-kernel']) {
                    return data.kversion;
                }
                let kernel = data['current-kernel'];
                let buildDate;
                try {
                    buildDate = kernel.version.match(/\((.+)\)\s*$/)[1] ?? 'unknown';
                } catch {
                    // Patch for some kernels not match (date).
                    buildDate = kernel.version ?? 'unknown';
                }
                return `${kernel.sysname} ${kernel.release} ( ${buildDate} )`;
            },
            value: '',
        },'''

text = file.read_text()

STEPS = "\033[95m步骤\033[0m"
INFO = "\033[94m信息\033[0m"
CYAN = "\033[95m"
RESET = "\033[0m"

if new in text:
    print(f"[ {INFO} ] 检测到内核版本显示已经修复过，无需重复修改！")
    sys.exit(2)

if old not in text:
    print(f"[ {INFO} ] 没有找到匹配的原始代码，当前 PVE 版本可能已不需要修复！")
    sys.exit(3)

backup = file.with_suffix(file.suffix + ".bak")
if not backup.exists():
    backup.write_text(text)
    print(f"[ {STEPS} ] 已备份: {CYAN}{backup}{RESET}")

file.write_text(text.replace(old, new))
print(f"[ {STEPS} ] 已修改: {CYAN}{file}{RESET}")
sys.exit(0)
EOF

    local py_status=$?
    if [[ ${py_status} -eq 0 ]]; then
        echo -e "${SUCCESS} 内核版本显示修复成功！"
    elif [[ ${py_status} -eq 2 ]]; then
        echo -e "${SUCCESS} 内核版本显示已是正常状态！"
    else
        echo -e "${INFO} 已跳过内核版本显示修复！"
    fi
}

mask_services() {
    echo -e "${STEPS} 正在屏蔽冲突服务..."
    systemctl mask systemd-networkd.service systemd-networkd.socket systemd-resolved NetworkManager >/dev/null 2>&1 || true
}

prompt_reboot() {
    if prompt_yes_no "${OPTIONS} 是否立即重启？[\033[92mY\033[0m/n]：" "y"; then
        for ((i = 5; i >= 0; i--)); do
            echo -ne "${STEPS} 倒计时：[ "
            for ((j = 5; j > i; j--)); do echo -ne "\e[31m=\e[0m"; done
            for ((j = i; j > 0; j--)); do echo -ne "\e[32m-\e[0m"; done
            echo -ne " ]\r"
            sleep 1
        done
        echo -e "\n${INFO} 重启中..."
        reboot
    else
        echo -e "${INFO} 请手动重启！"
    fi

    exit 0
}

main() {
    check_dependencies
    check_env
    check_select_interface
    detect_network_info
    confirm_source
    backup_and_comment_sources
    if [[ "${VERSION_CODENAME}" == "trixie" ]]; then
        repositories_select
    else
        setup_repositories_lierfang
    fi
    setup_networking
    set_hostname
    configure_network
    install_pve
    optimize_memory
    create_vmbr0
    configure_ipv6_sysctl
    if [[ "${pve_repo_type}" == "proxmox" ]]; then
        patch_pve_kernel_version
    fi
    mask_services
    prompt_reboot
}

main "$@"
